# --- Database -------------------------------------------------------------
# Local dev (zero setup): SQLite file. For Supabase use the Postgres connection
# string from Project Settings -> Database -> Connection string (URI), e.g.
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./reliefsync.db

# --- Auth -----------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-in-production
# MVP: OTP is simulated (FR-1.2). The code is returned in the API response and logged.
SIMULATE_OTP=true

# --- AI extraction (FR-3.x) -----------------------------------------------
# Leave empty to always use the rule-based extractor (NFR-9/10 fallback).
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Hard timeout for the LLM call, seconds (NFR-1). On timeout -> rule-based fallback.
LLM_TIMEOUT_SECONDS=5

# --- Photo storage ----------------------------------------------------------
# Empty -> photos saved to ./uploads and served by this API.
# Set both to upload to a Supabase Storage bucket (must be public) instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=report-photos

# --- Push notifications (FCM) ---------------------------------------------
# Path to a Firebase service-account JSON. Empty -> notifications are only
# stored in-app (the app polls them) and logged.
FIREBASE_CREDENTIALS=

# --- Engine / demo ----------------------------------------------------------
# How often the escalation / confirmation engine ticks, seconds.
TICK_SECONDS=2
# Seed simulated volunteers + demo accounts on first start.
SEED_DEMO_DATA=true
